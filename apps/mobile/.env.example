# Lokalnie: IP komputera w Wi-Fi/LAN (ipconfig), backend z docker compose.
# W buildzie APK: adres produkcyjny, np. https://api.twoja-domena.
EXPO_PUBLIC_API_URL=http://192.168.1.25:8000

# Adres aplikacji webowej: z niego budowane są linki zaproszeń (QR).
# Lokalnie: web z `pnpm --filter @shoplist/web dev`. W buildzie APK: https://twoja-domena.
EXPO_PUBLIC_WEB_URL=http://localhost:5173
