# Plik /opt/shoplist/.env na VPS (chmod 600, właściciel: deploy).
# Prawdziwych wartości nie commitujemy.

# Domeny: rekordy A (i AAAA, jeśli VPS ma IPv6) wskazują na VPS.
API_DOMAIN=api.example.pl
WEB_DOMAIN=example.pl

# Kontakt dla Let's Encrypt (powiadomienia o wygasaniu certyfikatów).
ACME_EMAIL=ty@example.pl

# Obrazy w GHCR, tylko małe litery (GHCR odrzuca wielkie).
BACKEND_IMAGE=ghcr.io/twoj-login/shoplist-backend
WEB_IMAGE=ghcr.io/twoj-login/shoplist-web

# Oba: openssl rand -hex 32
# Hasło w hexie, bo trafia do DATABASE_URL i nie wymaga escapowania.
# JWT_SECRET inny niż lokalny. Jego zmiana unieważnia wszystkie tokeny.
POSTGRES_PASSWORD=
JWT_SECRET=
